# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/placify?retryWrites=true&w=majority

# Server Port
PORT=5000

# Groq AI API Key
GROQ_API_KEY=your_groq_api_key_here

# News API Key
NEWS_API_KEY=your_news_api_key_here

# Internship / Job Provider Credentials (Adzuna API)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Optional Additional Internship API Providers (e.g. Jooble, JSearch / RapidAPI)
INTERNSHIP_API_KEY=your_api_key_here
INTERNSHIP_API_ID=your_api_id_here
RAPIDAPI_KEY=your_rapidapi_key_here

# YouTube RAG Service API URL
RAG_API_URL=http://127.0.0.1:8000
